# Modèle de configuration pour `ddev pull o2switch`.
# Copier en .ddev/o2switch.env (non versionné) et renseigner le mot de passe.
#   cp .ddev/o2switch.env.sample .ddev/o2switch.env

# --- Accès FTPS -------------------------------------------------------------
# Serveur réel o2switch (wamdancestudio.fr pointe sur le frontal proxy : inutilisable ici).
FTP_HOST=cpanel.wamdancestudio.fr
# Compte FTP dédié créé dans cPanel > Comptes FTP, cantonné à public_html.
FTP_USER=wam-sync@wamdancestudio.fr
FTP_PASS=
# Chemin du site relatif à la racine du compte FTP.
# Vide si le compte est déjà cantonné à public_html (cas du compte wam-sync),
# /public_html si l'on utilise le compte cPanel principal.
FTP_BASE=

# --- Accès MySQL distant ----------------------------------------------------
# Nécessite d'autoriser l'IP publique du poste dans cPanel > Bases de données > MySQL distant.
# Les identifiants de la base sont lus automatiquement dans le wp-config.php distant.
DB_HOST=cpanel.wamdancestudio.fr

# --- Repli si MySQL distant reste indisponible -------------------------------
# Chemin FTP d'un dump déposé sur le serveur (laisser vide pour désactiver le repli).
# Génération depuis le Terminal cPanel :
#   mkdir -p ~/dumps && cd ~/public_html && wp db export - | gzip -c > ~/dumps/wam-latest.sql.gz
DB_DUMP_REMOTE=
