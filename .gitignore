# Ignorer tout le répertoire WordPress par défaut
/*
!/.gitignore
!/.htaccess
!/wp-content/
!/.cpanel.yml
!/.ddev/

# Dans wp-content on ignore tout...
/wp-content/*
# ...sauf notre thème
!/wp-content/themes/
/wp-content/themes/*
!/wp-content/themes/wamV1/

# ...et notre plugin newsletter (les autres plugins restent hors dépôt :
# ils sont installés côté prod et rapatriés par `ddev pull`)
!/wp-content/plugins/
/wp-content/plugins/*
!/wp-content/plugins/wam-newsletter/

# Identifiants FTP/MySQL de production : jamais versionnés
/.ddev/o2switch.env

# Configuration et dumps SQL : jamais versionnés (dépôt public)
*.sql
*.sql.gz
*.tar.gz
*.zip
wp-config.php
wp-config-ddev.php
wp-config-local.php

# Fichiers système mac/windows
.DS_Store
Thumbs.db
